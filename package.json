{
  "name": "qa-portfolio-harness",
  "version": "0.2.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Shared TypeScript harness to start, health-check, seed, and authenticate portfolio products (Cal, Documenso, Medusa, Twenty).",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docker",
    "scripts",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"",
    "check": "npm run typecheck && npm test && npm run build",
    "up": "node scripts/up.mjs",
    "down": "node scripts/down.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "dotenv": "^16.4.7",
    "pg": "^8.14.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "typescript": "^5.8.2"
  }
}
