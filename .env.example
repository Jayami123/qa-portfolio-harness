# Copy to .env and fill in local values. Never commit .env.
# Placeholders only — do not put real secrets in this file.

# Absolute or relative path to the products/ folder (default: ../products)
PRODUCTS_ROOT=../products

# Optional overrides if a fork is not at the default name under PRODUCTS_ROOT
# CAL_PRODUCT_DIR=
# DOCUMENSO_PRODUCT_DIR=
# MEDUSA_PRODUCT_DIR=
# TWENTY_PRODUCT_DIR=

# --- Cal.com / Cal.diy ---
CAL_BASE_URL=http://127.0.0.1:3000
CAL_API_BASE_URL=http://127.0.0.1:5555
# Matches packages/prisma/docker-compose.yml + cal .env.example (empty password, trust auth)
CAL_DB_URL=postgresql://postgres:@localhost:5450/calendso
CAL_WEBHOOK_SECRET=
# Required for authenticate() / live smoke. Copy the `cal_…` key printed by the fork's `yarn db-seed`.
CAL_API_KEY=
# Optional. Default probes GET $CAL_API_BASE_URL/api/v2/me then /me with the Bearer token.
# CAL_AUTH_PROBE_URL=
# Optional. Default is production: next build then next start. Use dev for next-dev.
# CAL_WEB_MODE=prod
# CAL_WEB_MODE=dev
# CAL_WEB_REBUILD=1
# Optional. Timeout in ms for yarn turbo run build --filter=@calcom/trpc (default 600000, min 120000).
# CAL_TRPC_BUILD_MS=
# Optional. Default is webpack on Windows when CAL_WEB_MODE=dev (Cal's yarn dev --turbopack crashes on instrumentation.ts).
# CAL_WEB_BUNDLER=webpack
# CAL_WEB_BUNDLER=turbopack

# --- Documenso ---
# Use 127.0.0.1, never localhost (an IPv6-only bind can hide behind localhost). Port 3001 avoids Cal (3000) and Twenty (3002).
DOCUMENSO_BASE_URL=http://127.0.0.1:3001
# Harness-owned Postgres from docker/documenso.compose.yml (host port 5451).
DOCUMENSO_DB_URL=postgres://documenso:password@127.0.0.1:5451/documenso
# Optional. Passkey / browser origin. Listen and health stay on DOCUMENSO_BASE_URL (127.0.0.1:3001).
# Hostname must not be localhost or an IP; port must match 3001; must resolve to 127.0.0.1.
# DOCUMENSO_PUBLIC_URL=http://p1.lvh.me:3001
# Optional. Skip starting the web process: DOCUMENSO_SKIP_WEB_START=1
# Optional. Force a rebuild after local fork edits: DOCUMENSO_WEB_REBUILD=1
# Optional. Timeouts in ms: DOCUMENSO_WEB_BUILD_MS (default 2700000), DOCUMENSO_WEB_WAIT_MS (default 600000)
# Create in Settings → API tokens (tRPC api-token-router). Paste here.
DOCUMENSO_API_TOKEN=

# --- Medusa (DTC starter: products/medusa-dtc-starter) ---
# Use 127.0.0.1, never localhost. Backend health is GET /health HTTP 200.
MEDUSA_BASE_URL=http://127.0.0.1:9000
# Harness-owned Postgres from docker/medusa.compose.yml (host port 5433, database medusa).
MEDUSA_DB_URL=postgres://medusa:medusa@127.0.0.1:5433/medusa
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=
# Optional override. Leave empty. Never paste a live pk_ token into git.
MEDUSA_PUBLISHABLE_API_KEY=
MEDUSA_STOREFRONT_URL=http://127.0.0.1:8000
# MEDUSA_SKIP_STOREFRONT=1
# MEDUSA_SKIP_WEB_START=1
# MEDUSA_WEB_REBUILD=1
# Opt-in (default off): MEDUSA_REDIS=1 starts redis:7 on 127.0.0.1:6380 and wires Redis modules at runtime.
# Opt-in (default off): MEDUSA_STRIPE=1 registers payment-stripe; seed enables pp_stripe_stripe when STRIPE_API_KEY is set.
# MEDUSA_REDIS=1
# MEDUSA_STRIPE=1
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_KEY=
# MEDUSA_SEED_CUSTOMER_EMAIL=
# MEDUSA_SEED_CUSTOMER_PASSWORD=
# MEDUSA_BUILD_MS=600000
# MEDUSA_WEB_WAIT_MS=120000

# --- Twenty CRM ---
# Host 3002 avoids colliding with Cal on 3000. Use 127.0.0.1 (not localhost) on Windows.
TWENTY_BASE_URL=http://127.0.0.1:3002
TWENTY_DB_URL=postgres://postgres:postgres@127.0.0.1:5434/default
# Default Admin is jane.austen@apple.dev; password is the shared dev-seeder value (see fork seed-users.util.ts). Paste overrides here, do not commit.
# TWENTY_EMAIL=
# TWENTY_PASSWORD=
TWENTY_API_KEY=
TWENTY_IMAGE_TAG=v2.44.0
# Optional: first-boot wait budget in ms (default 600000, min 120000). Optional TWENTY_DOWN_VOLUMES=1 on down.
