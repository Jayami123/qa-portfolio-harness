# Copy to .env and fill in local values. Never commit .env.
# Placeholders only — do not put real secrets in this file.

# Absolute or relative path to the products/ folder (default: ../products)
PRODUCTS_ROOT=../products

# Optional overrides if a fork is not at the default name under PRODUCTS_ROOT
# CAL_PRODUCT_DIR=
# DOCUMENSO_PRODUCT_DIR=
# MEDUSA_PRODUCT_DIR=
# TWENTY_PRODUCT_DIR=

# --- Cal.com / Cal.diy ---
CAL_BASE_URL=http://localhost:3000
CAL_API_BASE_URL=http://localhost:5555
# Matches packages/prisma/docker-compose.yml + cal .env.example (empty password, trust auth)
CAL_DB_URL=postgresql://postgres:@localhost:5450/calendso
CAL_WEBHOOK_SECRET=
# Required for authenticate() / live smoke. Copy the `cal_…` key printed by the fork's `yarn db-seed`.
CAL_API_KEY=
# Optional. Default probes GET $CAL_API_BASE_URL/api/v2/me then /me with the Bearer token.
# CAL_AUTH_PROBE_URL=

# --- Documenso ---
# Host 3001 avoids colliding with Cal on 3000. Pass PORT=3001 when starting the app.
DOCUMENSO_BASE_URL=http://localhost:3001
# From the fork's docker/development/compose.yml + .env.example
DOCUMENSO_DB_URL=postgres://documenso:password@127.0.0.1:54320/documenso
# Create in Settings → API tokens (tRPC api-token-router). Paste here.
DOCUMENSO_API_TOKEN=

# --- Medusa ---
MEDUSA_BASE_URL=http://localhost:9000
# From scripts/portfolio-validation/docker-compose.yml
MEDUSA_DB_URL=postgres://medusa:medusa@localhost:5433/medusa_validation
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=
MEDUSA_PUBLISHABLE_API_KEY=

# --- Twenty CRM ---
# Host 3002 avoids colliding with Cal on 3000.
TWENTY_BASE_URL=http://localhost:3002
TWENTY_DB_URL=postgres://postgres:postgres@localhost:5434/default
TWENTY_EMAIL=
TWENTY_PASSWORD=
TWENTY_API_KEY=
# Image pin used by the fork's validation scripts
TWENTY_IMAGE_TAG=2.44.0
